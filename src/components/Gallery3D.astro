---
import { Image } from 'astro:assets';
import { t, type Lang } from '../i18n/ui';
import { fullSize } from '../lib/images';
import cloud from '../assets/gallery/cloud.jpg';
import donut from '../assets/gallery/donut.jpg';
import blockout from '../assets/gallery/blockout.jpg';
import laser from '../assets/gallery/laser.jpg';

interface Props { lang: Lang }
const { lang } = Astro.props;

// Pour ajouter un rendu : déposer l'image dans src/assets/gallery/, l'importer ci-dessus
// et l'ajouter ici. "size" : 'tall' (grande case, 2 lignes), 'wide' (2 colonnes) ou rien.
// "pos" : partie de l'image à garder visible quand elle est recadrée (x% y%).
const items = [
  { src: donut, caption: { fr: 'Donuts', en: 'Donuts' }, size: 'tall', pos: '40% 50%' },
  { src: cloud, caption: { fr: 'Nuage volumétrique', en: 'Volumetric cloud' }, size: 'wide', pos: '50% 58%' },
  { src: blockout, caption: { fr: 'Blockout de niveau', en: 'Level blockout' }, pos: '50% 50%' },
  { src: laser, caption: { fr: 'Piège laser', en: 'Laser trap' }, pos: '35% 50%' },
];
const full = await Promise.all(items.map((it) => fullSize(it.src)));
---
<section id="3d">
  <div class="wrap">
    <div class="sec-head">
      <span class="num">02</span><h2>{t(lang, '3d.title')}</h2>
      <p>{t(lang, '3d.subtitle')}</p>
    </div>
    <div class="gallery">
      {items.map((it, n) => (
        <figure class={it.size}>
          <a href={full[n]} data-lightbox="3d" data-caption={it.caption[lang]}>
            <Image src={it.src} alt={it.caption[lang]} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 560px" style={`object-position: ${it.pos}`} />
          </a>
          <figcaption>{it.caption[lang]}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-auto-rows: 230px; gap: 14px; }
  figure { position: relative; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); }
  figure.tall { grid-row: span 2; }
  figure.wide { grid-column: span 2; }
  figure a { display: block; width: 100%; height: 100%; }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  figcaption { pointer-events: none; }
  figure:hover :global(img) { transform: scale(1.04); }
  figcaption {
    position: absolute; left: 10px; bottom: 10px; font: 500 12px var(--mono);
    background: rgba(12,14,20,.8); padding: 4px 8px; border-radius: 6px; color: var(--muted);
  }
  @media (max-width: 860px) {
    .gallery { grid-template-columns: 1fr 1fr; grid-auto-rows: 160px; }
    figure.tall { grid-column: span 2; }
  }
</style>
