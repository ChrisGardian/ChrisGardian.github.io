---
import { Image } from 'astro:assets';
import { localePath, t, type Lang } from '../i18n/ui';
import { slugOf, type Project } from '../lib/projects';

interface Props { project: Project; lang: Lang }
const { project, lang } = Astro.props;
const d = project.data;
const href = localePath(lang, `/projects/${slugOf(project)}/`);
---
<a class:list={['card', { featured: d.featured }]} href={href}>
  <div class="media">
    {d.draft && <span class="kind draft">{t(lang, 'projects.draft')}</span>}
    {!d.draft && d.badge && <span class={`kind ${d.badge.tone}`}>{d.badge.text}</span>}
    <Image
      src={d.cover}
      alt={d.coverAlt}
      widths={d.featured ? [640, 960, 1280] : [480, 720, 960]}
      sizes={d.featured ? '(max-width: 860px) 100vw, 600px' : '(max-width: 860px) 100vw, 540px'}
    />
  </div>
  <div class="body">
    {d.label && <span class="label">{d.label}</span>}
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    {d.featured && d.stats && (
      <div class="stats">
        {d.stats.slice(0, 2).map((s) => <div>{s.value}<small>{s.label}</small></div>)}
      </div>
    )}
    <div class="foot">
      <div class="chips">{d.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
      <span class="more">{t(lang, 'projects.more')}</span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; transition: transform .2s, border-color .2s;
  }
  .card:hover { transform: translateY(-3px); border-color: var(--line-hover); }
  .media { position: relative; aspect-ratio: 16/9; overflow: hidden; background: #0f121a; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
  .card:hover .media :global(img) { transform: scale(1.03); }
  .kind {
    position: absolute; top: 12px; right: 12px; z-index: 1;
    font: 500 12px var(--mono); background: rgba(12,14,20,.85);
    padding: 3px 9px; border-radius: 6px; border: 1px solid var(--line);
  }
  .kind.pink { color: var(--accent-2); }
  .kind.blue { color: var(--accent-3); }
  .kind.green { color: var(--accent); }
  .kind.draft { color: #0c0e14; background: #ffd166; border-color: #ffd166; }
  .body { padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  h3 { font: 600 22px var(--head); }
  p { color: var(--muted); font-size: 15px; }
  .stats { display: flex; gap: 28px; margin-top: 4px; }
  .stats div { font: 600 22px var(--head); color: var(--accent); }
  .stats small { display: block; font: 400 12.5px var(--body); color: var(--muted); }
  .foot { margin-top: auto; padding-top: 10px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .more { font: 600 14px var(--body); color: var(--accent); white-space: nowrap; }
  .more::after { content: " →"; }

  .featured { grid-column: 1 / -1; flex-direction: row; }
  .featured .media { flex: 1.25; aspect-ratio: auto; min-height: 360px; }
  .featured .body { flex: 1; padding: 32px; }
  .featured h3 { font-size: 28px; }

  @media (max-width: 860px) {
    .featured { flex-direction: column; }
    .featured .media { min-height: 0; aspect-ratio: 16/10; }
    .featured .body { padding: 22px; }
  }
</style>
